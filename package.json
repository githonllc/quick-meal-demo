{
  "name": "quick-meal-demo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-design.mjs",
    "dev": "vite",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "e2e": "playwright test",
    "prebuild": "node scripts/copy-design.mjs",
    "build": "tsc -b && vite build",
    "design:export": "node scripts/export-design.mjs",
    "lint": "oxlint",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "icons": "bash scripts/make-icons.sh"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.3",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3",
    "wrangler": "^4.145.0"
  }
}
